    private async Task SaveSettings()
    {
        await AutoSave();
        _message = "Settings saved successfully!";
        StateHasChanged();
        await Task.Delay(3000);
        _message = string.Empty;
        StateHasChanged();
    }

    private async Task AutoSave()
    {
        // Sync lists back to settings
        _settings.ContentTypes = _contentTypes.Select(c => c.Value).ToList();
        _settings.CommonApplicationProperties = _commonProperties
            .Select(p => new KeyValuePair<string, string>(p.Key, p.Value))
            .ToList();

        SettingsService.UpdateSettings(_settings);
        await SettingsService.SaveToStorageAsync();
    }

    private async Task ExportSettings()
    {
        // Save property lists before exporting
        foreach (var entity in _settings.CannedMessages)
        {
            foreach (var scenario in entity.Value)
            {
                await SaveAppPropertiesFromList(entity.Key, scenario.Key);
                await SaveBrokerPropertiesFromList(entity.Key, scenario.Key);
            }
        }
        
        // Export to JSON and open in new tab
        var json = SettingsService.ExportSettingsAsJson();
        var fileName = $"asb-emulator-settings-{DateTime.Now:yyyyMMdd-HHmmss}.json";
        await JSRuntime.InvokeVoidAsync("downloadJsonFile", json, fileName);
    }

    private async Task TriggerFileImport()
    {
        if (_fileInputComponent?.Element != null)
        {
            await JSRuntime.InvokeVoidAsync("triggerFileInput", _fileInputComponent.Element);
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
                using var reader = new StreamReader(stream);
                var json = await reader.ReadToEndAsync();
                
                SettingsService.ImportSettingsFromJson(json);
                await SettingsService.SaveToStorageAsync();
                _settings = SettingsService.GetSettings();
                InitializePropertyLists();
                _message = "Settings imported successfully!";
            }
        }
        catch (Exception ex)
        {
            _message = $"Error importing settings: {ex.Message}";
        }
    }

    // Content Types
    private void AddContentType()
    {
        _contentTypes.Add(new ContentTypeItem { IsEditing = true });
    }

    private async Task SaveContentType(ContentTypeItem item)
    {
        if (string.IsNullOrWhiteSpace(item.Value)) return;
        // Check duplicates
        if (_contentTypes.Count(c => c != item && c.Value == item.Value) > 0)
        {
            // Could show error here
            return;
        }
        item.IsEditing = false;
        await AutoSave();
    }

    private void CancelContentType(ContentTypeItem item)
    {
        if (string.IsNullOrEmpty(item.OriginalValue) && string.IsNullOrEmpty(item.Value) && item.IsEditing)
        {
            _contentTypes.Remove(item);
        }
        else
        {
            item.Value = item.OriginalValue;
            item.IsEditing = false;
        }
    }
    
    private void EditContentType(ContentTypeItem item)
    {
        item.OriginalValue = item.Value;
        item.IsEditing = true;
    }

    private async Task RemoveContentType(ContentTypeItem item)
    {
        _contentTypes.Remove(item);
        await AutoSave();
    }

