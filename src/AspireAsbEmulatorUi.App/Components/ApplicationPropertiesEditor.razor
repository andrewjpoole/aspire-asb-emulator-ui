@using AspireAsbEmulatorUi.App.Models
@inject AspireAsbEmulatorUi.App.Services.SettingsService SettingsService
@inject IJSRuntime JSRuntime

<div>
    <div class="font-semibold mb-2">@Title</div>
    <div class="space-y-2">
        @foreach (var kv in Properties.Select((v, i) => (v, i)))
        {
            var idx = kv.i;
            <div class="flex gap-2 items-center">
                @if (Properties[idx].IsEditing)
                {
                              <input class="app-prop-key bg-slate-900 border border-slate-700 text-slate-100 px-2 py-1 rounded w-36" 
                                  @bind="Properties[idx].Key" 
                                  placeholder="Property key" 
                                  @onkeydown="(e) => OnRowKeyDown(idx, e)" />
                    <input class="bg-slate-900 border border-slate-700 text-slate-100 px-2 py-1 rounded flex-1" 
                           @bind="Properties[idx].Value" 
                           placeholder="Property value" 
                           @onkeydown="(e) => OnRowKeyDown(idx, e)" />
                    <button class="px-2 py-1 rounded border border-slate-600 text-slate-100 hover:bg-slate-700" 
                            @onclick="() => SaveRow(idx)">Save</button>
                    <button class="px-2 py-1 rounded border border-slate-600 text-slate-100 hover:bg-slate-700" 
                            @onclick="() => CancelEdit(idx)">Cancel</button>
                    @if (!string.IsNullOrEmpty(Properties[idx].ValidationMessage))
                    {
                        <div class="text-sm text-red-400 mt-1">@Properties[idx].ValidationMessage</div>
                    }
                }
                else
                {
                    <div class="bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 rounded w-36 font-medium">@Properties[idx].Key</div>
                    <div class="flex-1 truncate">@Properties[idx].Value</div>
                    <button class="px-2 py-1 rounded border border-slate-600 text-slate-100 hover:bg-slate-700" 
                            @onclick="() => EditRow(idx)">Edit</button>
                    <button class="px-2 py-1 rounded border border-slate-600 text-slate-100 hover:bg-slate-700" 
                            @onclick="() => RemoveProperty(idx)">Remove</button>
                }
            </div>
        }

        <div class="flex justify-between items-center">
            <div class="flex gap-2 items-center relative">
                <button class="px-2 py-1 rounded bg-slate-700 text-slate-100 hover:bg-slate-600" @onclick="ToggleAddMenu">Add ▾</button>
                @if (_showAddMenu)
                {
                    <div class="absolute left-0 mt-2 bg-slate-800 border border-slate-700 rounded shadow z-10 w-64">
                        <button class="w-full text-left px-3 py-2 hover:bg-slate-700" @onclick="() => AddSelectedCommonProperty(-2)">Custom...</button>
                        @for (int i = 0; i < _commonApplicationProperties.Count; i++)
                        {
                            var ci = i;
                            <button class="w-full text-left px-3 py-2 hover:bg-slate-700" @onclick="() => AddSelectedCommonProperty(ci)">@(_commonApplicationProperties[i].Key) : @(_commonApplicationProperties[i].Value)</button>
                        }
                    </div>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_validationMessage))
        {
            <div class="text-sm text-red-400 mt-2">@_validationMessage</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Application Properties";
    [Parameter] public List<PropertyItem> Properties { get; set; } = new();
    [Parameter] public EventCallback OnPropertiesChanged { get; set; }

    
    private List<KeyValuePair<string, string>> _commonApplicationProperties = new();
    private int _selectedCommonPropertyIndex = -1;
    private string _validationMessage = string.Empty;
    private bool _showAddMenu = false;

    public class PropertyItem 
    { 
        public string Key { get; set; } = string.Empty; 
        public string Value { get; set; } = string.Empty; 
        public bool IsEditing { get; set; } = false;
        public string ValidationMessage { get; set; } = string.Empty;
        public string? OriginalKey { get; set; }
        public string? OriginalValue { get; set; }
    }

    

    private void AddRow()
    {
        var item = new PropertyItem { IsEditing = true, OriginalKey = string.Empty, OriginalValue = string.Empty };
        Properties.Add(item);
    }

    private void EditRow(int idx)
    {
        if (idx < 0 || idx >= Properties.Count) return;
        var p = Properties[idx];
        p.OriginalKey = p.Key;
        p.OriginalValue = p.Value;
        p.IsEditing = true;
    }

    private void CancelEdit(int idx)
    {
        if (idx < 0 || idx >= Properties.Count) return;
        var p = Properties[idx];
        if (string.IsNullOrEmpty(p.OriginalKey) && string.IsNullOrEmpty(p.OriginalValue))
        {
            // newly added empty row - remove it
            Properties.RemoveAt(idx);
        }
        else
        {
            p.Key = p.OriginalKey ?? string.Empty;
            p.Value = p.OriginalValue ?? string.Empty;
            p.IsEditing = false;
        }
    }

    private async Task SaveRow(int idx)
    {
        if (idx < 0 || idx >= Properties.Count) return;
        var p = Properties[idx];
        if (string.IsNullOrWhiteSpace(p.Key)) return;
        // Check for duplicates (ignore same index)
        var duplicate = Properties
            .Where((item, i) => i != idx && !string.IsNullOrWhiteSpace(item.Key))
            .Any(item => string.Equals(item.Key, p.Key, StringComparison.OrdinalIgnoreCase));

        if (duplicate)
        {
            p.ValidationMessage = $"A property with key '{p.Key}' already exists for this message.";
            StateHasChanged();
            return;
        }

        // Clear any validation and commit
        p.ValidationMessage = string.Empty;
        p.IsEditing = false;
        p.OriginalKey = null;
        p.OriginalValue = null;
        await OnPropertiesChanged.InvokeAsync();
    }

    private async Task OnRowKeyDown(int idx, KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveRow(idx);
    }

    private async Task RemoveProperty(int idx)
    {
        if (idx >= 0 && idx < Properties.Count)
        {
            Properties.RemoveAt(idx);
            await OnPropertiesChanged.InvokeAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddRow();
        }
    }

    protected override void OnInitialized()
    {
        LoadCommonApplicationProperties();
    }

    private void LoadCommonApplicationProperties()
    {
        _commonApplicationProperties.Clear();
        var settings = SettingsService.GetSettings();
        if (settings?.CommonApplicationProperties != null)
        {
            foreach (var kv in settings.CommonApplicationProperties)
            {
                _commonApplicationProperties.Add(kv);
            }
        }
        _selectedCommonPropertyIndex = -2; // default to Custom
    }

    private async void AddSelectedCommonProperty(int selectedIndex = -1)
    {
        _validationMessage = string.Empty;
        var idx = selectedIndex;
        if (idx == -1) idx = _selectedCommonPropertyIndex;

        // Close the add menu on any selection/click so it doesn't remain open
        _showAddMenu = false;

        if (idx == -2)
        {
            // Custom - create an empty editable row (editable so they can type key/value)
            AddRow();
            _selectedCommonPropertyIndex = -2;
            await OnPropertiesChanged.InvokeAsync();
            // focus the key input of the newly added row using JS selector
            await Task.Yield();
            try
            {
                await JSRuntime.InvokeVoidAsync("asbEditor.focusLastAppPropKey");
            }
            catch { }
            _showAddMenu = false;
            return;
        }

        if (idx >= 0 && idx < _commonApplicationProperties.Count)
        {
            var kv = _commonApplicationProperties[idx];

            // Prevent duplicate keys in the current message
            if (Properties.Any(p => string.Equals(p.Key, kv.Key, StringComparison.OrdinalIgnoreCase)))
            {
                _validationMessage = $"A property with key '{kv.Key}' already exists for this message.";
                StateHasChanged();
                return;
            }

            // Add as a non-editing saved row
            var item = new PropertyItem { Key = kv.Key, Value = kv.Value, IsEditing = false };
            Properties.Add(item);
            _selectedCommonPropertyIndex = -2;
            await OnPropertiesChanged.InvokeAsync();
            StateHasChanged();
            _showAddMenu = false;
        }
    }

    private void ToggleAddMenu()
    {
        _showAddMenu = !_showAddMenu;
    }

    
}
